POSTGRES_DB=novel2anime
POSTGRES_USER=novel2anime
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://novel2anime:change-me@postgres:5432/novel2anime
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_PORT=3300
BACKEND_PORT=3301
APP_ORIGIN=http://localhost:3300
COMFYUI_ROOT=/comfyui
COMFYUI_WORKERS=gpu0=http://host.docker.internal:8188,gpu1=http://host.docker.internal:8189
COMFYUI_LOG_FILES=/comfyui/logs/gpu0.log,/comfyui/logs/gpu1.log
COMFYUI_PROCESS_CONTROL=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_SELECTION_CHARS=12000
LLM_MAX_RETRIES=2

